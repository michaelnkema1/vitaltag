# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never expose to the client (no NEXT_PUBLIC_ prefix). Only
# needed for admin scripts (e.g. seeding pharmacies) -- app routes use RLS
# via the anon key instead.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
